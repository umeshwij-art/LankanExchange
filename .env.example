# ---- Server (Vercel project → Settings → Environment Variables) ----

# Firebase service account JSON (Firebase console → Project settings →
# Service accounts → Generate new private key). Paste the whole JSON, or
# base64 it first: base64 -i key.json | pbcopy
FIREBASE_SERVICE_ACCOUNT=

# Optional: Firestore database id (defaults to the app's current database)
FIRESTORE_DATABASE_ID=

# Random string. Vercel Cron sends it as a Bearer token to /api/cron/eod.
# Generate one with: openssl rand -hex 32
CRON_SECRET=
