rules_version = '2';

// All balances, positions, orders and trades are written by the server
// (Firebase Admin, which bypasses these rules). The browser can only read:
//   • public market data and the leaderboard
//   • its own account and sub-collections
service cloud.firestore {
  match /databases/{database}/documents {

    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // End-of-day prices: market/snapshot, market/lastRun
    match /market/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Daily OHLCV bars per security
    match /history/{symbol} {
      allow read: if true;
      allow write: if false;
    }

    // Public ranking (first name + initial only)
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // Private account + positions, orders, trades
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;

      match /{sub=**} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    // Everything else, including legacy collections, is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
